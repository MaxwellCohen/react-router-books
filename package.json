{
  "name": "react-router-books",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/@react-router/dev/bin.cjs dev --port 3000",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "deploy:vercel": "vercel build --prod --yes && vercel deploy --prebuilt --prod --yes",
    "deploy:netlify": "NETLIFY=1 pnpm build && npx --yes netlify-cli deploy --prod --no-build",
    "deploy:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler deploy",
    "preview:cloudflare": "CLOUDFLARE=1 pnpm build && wrangler dev",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.43",
    "@neondatabase/serverless": "^1.2.1",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.3",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/react-router": "^1.3.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
